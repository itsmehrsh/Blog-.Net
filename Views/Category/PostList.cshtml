@model List<Blog.Web.Models.Post>

@{
    ViewData["Title"] = "Home Page";
}

@foreach (var post in Model)
{
    <div class="card post-item bg-transparent border-0 mb-5">
        @*<a asp-controller="Post" asp-action="Detail" asp-route-postId="@post.Id">
            <img class="card-img-top rounded-0" src="~/images/post/post-lg/01.png" alt="">
        </a>*@
        <div class="card-body px-0">
            <h2 class="card-title">
                <a class="text-white opacity-75-onHover" asp-controller="Post" asp-action="Detail" asp-route-postId="@post.Id">@post.Title</a>
            </h2>
            <ul class="post-meta mt-3">
                <li class="d-inline-block mr-3">
                    <span class="fas fa-clock text-primary"></span>
                    <a class="ml-1" href="#">@post.Published</a>
                </li>
                <li class="d-inline-block">
                    <span class="fas fa-list-alt text-primary"></span>
                    <a class="ml-1" href="#">@post.Category.Title</a>
                </li>
            </ul>
            <p class="card-text my-4">@post.Summary</p>
            <a asp-controller="Post" asp-action="Detail" asp-route-postId="@post.Id" class="btn btn-primary">Read More <img src="~/images/arrow-right.png" alt=""></a>
        </div>
    </div>
}